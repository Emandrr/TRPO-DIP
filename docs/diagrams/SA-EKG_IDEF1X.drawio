BackgroundColor=#FFFFFF;fontFamily=GOST type A;fontColor=#000000;fontSize=13;exitX=0.9231;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.9231;entryY=0.0000;entryDx=0;entryDy=0;endArrow=oval;endFill=1;endSize=9;dashed=1;dashPattern=8 5;" edge="1" parent="1" source="E74" target="E83"><mxGeometry relative="1" as="geometry"><mxPoint x="-52" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="R121" value="назначает" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=2;labelBackgroundColor=#FFFFFF;fontFamily=GOST type A;fontColor=#000000;fontSize=13;exitX=0.4231;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.9192;entryY=0.0000;entryDx=0;entryDy=0;endArrow=oval;endFill=1;endSize=9;dashed=1;dashPattern=8 5;" edge="1" parent="1" source="E74" target="E88"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300.0" y="1100.0"/><mxPoint x="1069.0" y="1100.0"/></Array><mxPoint x="0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="c122" value="&lt;b&gt;Примечания&lt;/b&gt;&lt;br&gt;1 Модель построена по методологии IDEF1X (Р 50.1.020-2001), вид — полностью атрибутивный, для PostgreSQL 16 (раздел 4.1 PLAN.md). Таблицы DuckDB показаны на листе 2.&lt;br&gt;2 Связь users — patients / doctors — неполная категориальная: дискриминатор role; пользователь с ролью Admin сущности-категории не имеет.&lt;br&gt;3 Связь «Запись ЭКГ — Отчёт анализа» — один к нулю или одному (UNIQUE record_id), мощность Z.&lt;br&gt;4 Атрибуты deleted_by и assigned_by в плане не имеют внешних ключей, показаны как обычные атрибуты.&lt;br&gt;5 Мягкое удаление (is_deleted, deleted_at, deleted_by) — решение D8 плана.&lt;br&gt;6 Сущность background_jobs связей не имеет: payload ссылается на запись логически." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontSize=13;fontFamily=GOST type A;fontColor=#000000;strokeColor=none;strokeWidth=1;fillColor=none;spacingLeft=4;spacingRight=4;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1530.0" y="975.0" width="670.0" height="285.0" as="geometry"/></mxCell><mxCell id="c123" value="&lt;b&gt;Условные обозначения IDEF1X&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=13;fontFamily=GOST type A;fontColor=#000000;strokeColor=none;strokeWidth=1;fillColor=none;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="110.0" y="1387.0" width="400.0" height="22.0" as="geometry"/></mxCell><mxCell id="c124" value="" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontFamily=GOST type A;fontColor=#000000;strokeColor=#000000;strokeWidth=2;fillColor=none;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="110.0" y="1413.0" width="70.0" height="16.0" as="geometry"/></mxCell><mxCell id="c125" value="независимая сущность (прямоугольные углы)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=13;fontFamily=GOST type A;fontColor=#000000;strokeColor=none;strokeWidth=1;fillColor=none;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="205.0" y="1411.0" width="600.0" height="20.0" as="geometry"/></mxCell><mxCell id="c126" value="" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontFamily=GOST type A;fontColor=#000000;strokeColor=#000000;strokeWidth=2;fillColor=none;spacingLeft=2;spacingRight=2;spacingTop=0;spacingBottom=0;absoluteArcSize=1;arcSize=16;" vertex="1" parent="1"><mxGeometry x="110.0" y="1435.0" width="70.0" height="16.0" as="geometry"/></mxCell><mxCell id="c127" value="зависимая сущность (скруглённые углы)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=13;fontFamily=GOST type A;fontColor=#000000;strokeColor=none;strokeWidth=1;fillColor=none;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><